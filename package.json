{
  "name": "codex2claude",
  "version": "0.1.0-alpha.1",
  "description": "Local Codex MCP bridge to a native interactive Claude Code channel",
  "type": "module",
  "bin": {
    "codex2claude": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avhrst/codex2claude.git"
  },
  "license": "MIT",
  "files": [
    "dist",
    "plugin",
    "docs",
    "README.md",
    "CODEX_HANDOFF.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "tsc --noEmit && prettier --check src tests scripts/*.mjs plugin package.json tsconfig.json",
    "format": "prettier --write src tests scripts/*.mjs plugin package.json tsconfig.json",
    "start": "node dist/cli.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.4",
    "prettier": "3.9.9"
  }
}
